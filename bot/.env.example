# Photon project (dashboard > Settings, or `photon projects show`). Needed for iMessage, not for
# the terminal provider.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# The site whose /api/bot routes do the work. No trailing slash. Never hardcoded in the bot.
SITE_URL=https://0x-stacks-club.vercel.app
# Same value as BOT_API_SECRET in Vercel. Generate with: openssl rand -hex 32
BOT_API_SECRET=

# Gemini (optional). With a key the bot holds a normal conversation and uses the site's data to
# answer. Without one it only understands the plain commands.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried when the main model is slow, overloaded or rate limited.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# imessage (default) or terminal. `pnpm terminal` sets this for you.
BOT_PROVIDER=imessage
# Terminal provider only: the phone the terminal chat stands in for, in E.164. Use the number you
# connected on the site so the /api/bot routes see a linked phone.
TERMINAL_PHONE=

# Optional. Stop replying this far below Photon's 5,000 messages per server per day.
DAILY_SEND_LIMIT=4500
LOG_LEVEL=info
